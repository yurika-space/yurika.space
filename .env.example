# yurika.space frontend — copy to .env.local

# Django API (yurika monorepo backend)
NEXT_PUBLIC_API_URL=http://localhost:8000/api

# Site URL (SIWE, OG)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase waitlist (browser + server route)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Dynamic.xyz wallet UI
NEXT_PUBLIC_DYNAMIC_ENVIRONMENT_ID=

# On-chain (after Base Sepolia deploy — see ~/code/yurika/contracts)
NEXT_PUBLIC_BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
NEXT_PUBLIC_YURIKA_VAULT_ADDRESS=
NEXT_PUBLIC_SHARD_TOKEN_ADDRESS=

# Django backend (docker-compose / .env in yurika monorepo) — set after deploy
# YURIKA_VAULT_CONTRACT_ADDRESS=0x...
# Populates domain.vault_contract_address on vault when set
